# 하네스 오케스트레이션(AI-07, app/orchestration/harness.py)용 환경변수.
# 실제 값은 여기(.env.example)가 아니라 .env(git 미포함)나 배포 환경 설정에 넣을 것.
#
# 둘 중 하나라도 비어있으면 하네스는 LLM을 호출하지 않고 규칙기반 폴백으로 동작한다
# (서버가 죽지 않는다 — harness.py의 decide_next_action() 참고).

ANTHROPIC_API_KEY=

# 팀이 Anthropic 콘솔에서 실제 사용할 모델 이름을 확인해서 채워넣을 것.
# 코드에 특정 모델 이름을 하드코딩해두지 않은 이유는 harness.py 상단 주석 참고.
HARNESS_LLM_MODEL=

# 고관절 과신전 LLM 2차 확인(2026-08-28, app/coaching/hyperextension_llm_check.py)용
# 환경변수 — 위 하네스와 달리 AWS Bedrock으로 붙는다(ANTHROPIC_API_KEY 재사용 안 함).
# 둘 중 하나라도 비어있으면(또는 AWS 자격증명이 없으면) 이 검사는 조용히 비활성화되고
# DTW 임곗값 단독 판정으로 폴백한다(realtime.py 주석 참고). AWS 자격증명 자체는 여기
# 넣지 않는다 — boto3 기본 체인(환경변수/프로파일/IAM 롤)을 그대로 쓴다.
AWS_BEDROCK_REGION=
HYPEREXTENSION_BEDROCK_MODEL_ID=

# 측면 DTW 정상 렙 템플릿(app/pose/dtw_templates/*.json)을 S3에서 불러오기 위한
# 환경변수(2026-08-28, app/pose/dtw_template_store.py) — 위 Bedrock 변수와는 별개
# 리소스(S3 버킷)를 가리키므로 이름을 재사용하지 않는다. 셋 중 하나라도 비어있으면
# S3를 건너뛰고 로컬 캐시 → app/pose/dtw_templates/ 디렉토리 순으로 조용히
# 폴백한다(dtw_template_store.py의 load_templates_for_store 참고). AWS 자격증명
# 자체는 여기 넣지 않는다 — boto3 기본 체인(환경변수/프로파일/IAM 롤)을 그대로 쓴다.
DTW_TEMPLATES_S3_BUCKET=
DTW_TEMPLATES_S3_KEY=
DTW_TEMPLATES_S3_REGION=
