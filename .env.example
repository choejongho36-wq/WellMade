# 서버(EC2)에서 이 파일을 .env.prod 로 복사해 실제 값을 채운다. .env.prod 는 커밋 금지.
#   cp .env.prod.example .env.prod && nano .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- 공개 도메인 (프론트가 API/AI를 호출할 주소, 보통 이 서버의 https 도메인) ---
VITE_API_BASE=https://your-domain.com
VITE_AI_BASE=https://your-domain.com

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=wellmade
MYSQL_USER=wellmade_user
MYSQL_PASSWORD=change-me

# --- 백엔드 시크릿 (application.yml 의 ${...} 가 읽음) ---
JWT_SECRET=
GEMINI_API_KEY=
DATA_GO_KR_HOLIDAY_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 백엔드 런타임 설정 ---
# 로그인 후 프론트로 돌려보낼 주소
APP_OAUTH2_REDIRECT_URI=https://your-domain.com/oauth/redirect
# CORS 허용 오리진 (프론트를 같은 nginx로 묶으면 사실상 불필요하지만 안전하게)
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com
# 챗봇 LLM - 별도 GPU 인스턴스의 사설 IP
OLLAMA_BASE_URL=http://10.0.0.10:11434

# --- AI 서버 ---
ALLOWED_ORIGINS=https://your-domain.com
ANTHROPIC_API_KEY=
HARNESS_LLM_MODEL=
